{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDescriptor Studio",
  "version": "0.1.0",
  "identifier": "com.mdescriptor.studio",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MDescriptor Studio",
        "label": "main",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/backend"],
    "resources": ["binaries/backend-x86_64-pc-windows-msvc.exe.sha256"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCOUY5NUQ1NjlDQ0FFRDcKUldUWHJzeHAxWldmKzVUNXR5SXJsbTNsUHVLMlFCQy9RU2pWVnpUT1J3cE1NaFlpcTZIcXZIbFkK",
      "endpoints": [
        "https://github.com/nicheal/MDescriptorStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
